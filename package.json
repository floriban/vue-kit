{
  "name": "vue-kit",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "check": "run-s type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "registry:build": "node packages/cli/scripts/build-assets.mjs",
    "cli:pack": "npm run registry:build && npm pack --workspace packages/cli"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@lucide/vue": "^1.42.0",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "echarts": "^6.1.0",
    "flatpickr": "^4.6.13",
    "sortablejs": "^1.15.7",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.40",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floriban/vue-kit.git"
  },
  "homepage": "https://github.com/floriban/vue-kit#readme",
  "bugs": {
    "url": "https://github.com/floriban/vue-kit/issues"
  }
}
